#!/bin/sh
# PHP2Shell training-lab service (PID 1 inside the microVM).
#
# The guest init runs this as root after MMDS flags are on the tmpfs. Apache
# binds :8080 as root, then its prefork child drops to www-data (uid 33) --
# the uid the exploit proof asserts.
set -eu

mkdir -p /www /tmp

# --- flag resolution (lab "main", platform "flags_static"; see README) ---
# Publish the per-instance flag (tmpfs, never baked into the image) so the
# lab has a real objective. /run, NOT /www: /www is the Apache
# DocumentRoot, so a flag copied there is served verbatim at /flag.txt
# over plain HTTP. The init mounts /run tmpfs root-only (mode=0700), so
# the service opens traversal of the tmpfs root it publishes into; the
# raw flags directory /run/rctf (0700, init-owned) stays root-only and the
# flag bytes live only on the tmpfs. The flag SOURCE is resolved
# name-robustly: the lab runner registers "main"; the rCTF platform
# passes the challenge's registered provider name through verbatim
# ("flags/static"), which the guest init sanitises to "flags_static";
# then the single file when exactly one exists. The staged records
# decide placement from the per-record CHALLENGE env: fc-m364-recon
# publishes only into the static incident note (plus a documented
# non-flag sentinel on the RCE path); anything else publishes only to
# /run/flag.txt for the RCE stage. F points at the objective so it fits
# the calibrated 14-byte carrier budget: `env>/www/p` reveals the
# pointer and `cat $F>/www/p` reads it.
chmod 0711 /run
M364_INTAKE_NOTE='M364 intake note: the credit reference for this incident is filed with the post-incident review.'
if [ -n "${RCTF_FLAGS_DIR:-}" ] && [ -d "$RCTF_FLAGS_DIR" ]; then
  flag_src=
  for cand in main flags_static; do
    if [ -z "$flag_src" ] && [ -f "$RCTF_FLAGS_DIR/$cand" ]; then
      flag_src=$RCTF_FLAGS_DIR/$cand
    fi
  done
  if [ -z "$flag_src" ]; then
    set -- "$RCTF_FLAGS_DIR"/*
    if [ "$#" -eq 1 ] && [ -f "$1" ]; then
      flag_src=$1
    fi
  fi
fi
if [ -n "$flag_src" ]; then
  case "${CHALLENGE:-}" in
    fc-m364-recon)
      M364_FLAG_VALUE="$(cat "$flag_src")" awk '
        index($0, "<!--M364-FLAG-SLOT-->") {
          print "      <p class=\"note-flag\">Approved credit reference: " ENVIRON["M364_FLAG_VALUE"] "</p>"
          next
        }
        { print }
      ' /www/incidents/EX2611-0442.html >/www/incidents/.EX2611-0442.new &&
        mv /www/incidents/.EX2611-0442.new /www/incidents/EX2611-0442.html &&
        chmod 0644 /www/incidents/EX2611-0442.html
      printf '%s' "$M364_INTAKE_NOTE" >/run/m364-intake.txt
      chmod 0644 /run/m364-intake.txt
      ;;
    *)
      cp "$flag_src" /run/flag.txt
      chmod 0644 /run/flag.txt
      ;;
  esac
fi
case "${CHALLENGE:-}" in
  fc-m364-recon) F_PATH=/run/m364-intake.txt ;;
  *) F_PATH=/run/flag.txt ;;
esac
export F=$F_PATH
# --- end flag resolution ---

# The webroot must be writable by the worker for the out-of-band proof
# (`id>/www/p`).
chown -R www-data:www-data /www 2>/dev/null || true
chmod 0755 /www
chmod 0644 /www/index.php 2>/dev/null || true

exec /opt/php2shell/apache/bin/httpd -D FOREGROUND \
  -f /opt/php2shell/apache/conf/php2shell.conf
